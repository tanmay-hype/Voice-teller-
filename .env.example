# Database (for Render: use external PostgreSQL connection string)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/aivoice

# Redis (for single-instance Render: uses localhost)
REDIS_URL=redis://127.0.0.1:6379/0

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# CORS (set to your Netlify URL for production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-site.netlify.app

# External APIs (required for story generation and voice synthesis)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Azure/Production audio service settings
AUDIO_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=story-audio
PIPER_SERVICE_URL=http://piper:8080

# Email Configuration (Resend API)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Voice Teller <onboarding@resend.dev>

# Security
SECRET_KEY=change-this-to-a-random-string-in-production

# OTP Settings
OTP_EXPIRY_MINUTES=15

# Keep-alive (to prevent Render free tier from idling)
KEEPALIVE_ENABLE=true
KEEPALIVE_INTERVAL_SECONDS=300
KEEPALIVE_URL=https://your-render-service.onrender.com/health

# Piper TTS (local fallback voice synthesis)
PIPER_USE_DOCKER=0
PIPER_MODEL_PATH=/models/en_US-amy-medium.onnx
PIPER_CONFIG_PATH=/models/en_US-amy-medium.onnx.json
PIPER_DOCKER_CONTAINER=piper
